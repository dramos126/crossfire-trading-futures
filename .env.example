# Copy to .env.local (`cp .env.example .env.local`) and fill in what you need.
# Every variable is optional: an install with an empty .env.local starts, and
# broker credentials are entered in the browser on first run (Settings), where
# they are stored in the local SQLite database. `next dev`, `next start` and the
# backtest CLI read .env.local. A container build takes the build-time
# variables (NEXT_PUBLIC_*) only as build arguments. Never commit .env.local.

# ── Environment ────────────────────────────────────────────────────────────
# `staging` (the default when unset or anything else) or `prod`. Decided at
# build time — rebuild after changing it.
#   staging: auto-trading is limited to practice accounts, Tradovate uses its
#            demo host, the header shows a non-prod banner, and the example
#            strategies under strategies/test/ are registered.
#   prod:    Tradovate uses its live host (and its accounts are tradable),
#            Topstep Combine (`50KTC-`…) and ExpressFunded (`EXPRESS-`)
#            accounts become tradable, and only the production strategy list
#            is registered. Any other Topstep account is treated as live and
#            refused in either mode.
# Start with staging and a practice or sim account.
NEXT_PUBLIC_APP_ENV=staging

# Where the SQLite database lives. Default: ./data/trading.db, created on
# first start.
# TRADING_DB_PATH=./data/trading.db

# ── Topstep (ProjectX API) ─────────────────────────────────────────────────
# Usually entered in the browser on first run instead. Set these only for an
# install that should take its credentials from the environment; the database
# value wins when both exist. Get an API key from your ProjectX / TopstepX
# account's API settings (an API subscription may be required).
# TOPSTEP_USERNAME=
# TOPSTEP_API_KEY=

# API hosts. The defaults are Topstep's public endpoints; override only to
# point at another ProjectX gateway.
# NEXT_PUBLIC_TOPSTEP_API_URL=https://api.topstepx.com
# NEXT_PUBLIC_TOPSTEP_HUB_URL=https://rtc.topstepx.com/hubs

# true: build bars from the realtime market hub's trades. Unset or false: poll
# REST for bars every 30 seconds.
USE_REALTIME_BARS=true

# ── Notifications ──────────────────────────────────────────────────────────
# Discord webhook for trade and alert messages (Discord: channel settings →
# Integrations → Webhooks). Can also be set in Settings, which wins.
# TRADE_NOTIFIER_WEBHOOK_URL=

# ── Tradovate ──────────────────────────────────────────────────────────────
# No variables: Tradovate credentials are entered in Settings. The demo/live
# host follows NEXT_PUBLIC_APP_ENV above.

# ── Historical data (Databento) — backtests ────────────────────────────────
# Backtests read 1-minute bars from a local Parquet cache filled from
# Databento (https://databento.com, paid per download). Live trading does not
# need any of this; it gets its bars from the broker.
#
# API key, for `corepack yarn backfill:databento` and the Settings probe. Can
# also be set in Settings.
# DATABENTO_API_KEY=
# Folder holding the cache (`ohlcv-1m/` is created under it).
# BAR_CACHE_DIR=./data/bar-cache
# Folder the backtest CLI writes runs to and the app's Saved Runs panel reads.
# Default: $BAR_CACHE_DIR/backtests, or ./backtests when BAR_CACHE_DIR is unset.
# BACKTEST_ARTIFACTS_DIR=./backtests
# How many processes the backtest CLI's walk-forward sweep and lift folds spread
# over (`--workers` overrides it for one run). 1 to this machine's core count.
# Default: 1.
# BACKTEST_WORKERS=4

# ── Developer tools ────────────────────────────────────────────────────────
# The /dev page and /api/dev/* routes send hand-built requests to the broker,
# including order placement. Off unless both are true. Never enable on an
# install that can reach a funded account. NEXT_PUBLIC_DEV_TOOLS_ENABLED is
# read at build time.
# DEV_TOOLS_ENABLED=true
# NEXT_PUBLIC_DEV_TOOLS_ENABLED=true

# ── Logging ────────────────────────────────────────────────────────────────
# Minimum console level: debug | info | warn | error. Default: debug in
# development, info in production.
# LOG_LEVEL=info
# Debug tags to show, comma-separated (e.g. auth,signalr,eval), or * for all.
# DEBUG_TAGS=
# Development only: `off` stops masking secrets in log lines. Production always
# masks.
# LOG_REDACT=off
